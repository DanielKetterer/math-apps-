{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://danielketterer.github.io/math-apps-/schemas/project-registry.schema.json",
  "title": "Math Apps project registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "projects"],
  "properties": {
    "version": { "const": 1 },
    "projects": {
      "type": "array",
      "items": { "$ref": "#/$defs/project" }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "summary", "target_nodes", "audience", "learning_objectives", "interaction_rationale", "assessment", "evidence", "scope"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 3 },
        "status": { "enum": ["proposed", "researching", "specified", "approved", "building", "review", "published", "paused", "rejected"] },
        "summary": { "type": "string", "minLength": 10 },
        "target_nodes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "audience": { "type": "string", "minLength": 3 },
        "learning_objectives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } },
        "interaction_rationale": { "type": "string", "minLength": 10 },
        "misconceptions": { "type": "array", "items": { "type": "string" } },
        "assessment": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "scope": { "type": "object", "additionalProperties": false, "required": ["included", "excluded"], "properties": { "included": { "type": "array", "items": { "type": "string" } }, "excluded": { "type": "array", "items": { "type": "string" } } } },
        "priority": { "type": "object", "additionalProperties": false, "properties": { "educational_value": { "type": "integer", "minimum": 1, "maximum": 5 }, "need_evidence": { "type": "integer", "minimum": 1, "maximum": 5 }, "interactive_fit": { "type": "integer", "minimum": 1, "maximum": 5 }, "reach": { "type": "integer", "minimum": 1, "maximum": 5 }, "feasibility": { "type": "integer", "minimum": 1, "maximum": 5 }, "notes": { "type": "string" } } },
        "app_path": { "type": ["string", "null"] },
        "app_url": { "type": ["string", "null"], "format": "uri" },
        "owner": { "type": "string" },
        "last_reviewed": { "type": "string", "format": "date" }
      }
    }
  }
}
